(rule
 (alias e2e-cbl08)
 (enabled_if
  (= %{env:CABAL_E2E_TESTS=0} 1))
 (deps ../bin/process_group_launcher.exe test_media_web_schema_backends.exe)
 (action
  (run ./test_media_web_schema_backends.exe)))

(rule
 (alias e2e)
 (enabled_if
  (= %{env:CABAL_E2E_TESTS=0} 1))
 (deps
  ../bin/process_group_launcher.exe
  test_demo_627.exe
  test_native_json_schema_backends.exe
  test_media_web_schema_backends.exe)
 (action
  (progn
   (run ./test_demo_627.exe)
   (run ./test_native_json_schema_backends.exe)
   (run ./test_media_web_schema_backends.exe))))


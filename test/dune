 (modules test_demo_628))

(test
 (name test_native_json_schema_backends)
 (libraries
  cabal
  cabal_e2e_harness_config
  alcotest
  eio
  eio_posix
  yojson
  unix)
 (modules test_native_json_schema_backends)
 (enabled_if
  (= %{env:CABAL_E2E_TESTS=0} 1)))

(rule
 (alias e2e)
 (enabled_if
  (= %{env:CABAL_E2E_TESTS=0} 1))
 (deps test_demo_627.exe test_native_json_schema_backends.exe)
 (action
  (progn
   (run ./test_demo_627.exe)
   (run ./test_native_json_schema_backends.exe))))


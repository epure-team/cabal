; cabal-mcp: stateful MCP server over cabal's live sessions + composition.
;
; mcp-kit isn't a hard dependency of the standalone cabal build: dune's
; (optional) field is documented to skip an executable when its libraries
; aren't available, but that skip does not actually happen for executable
; stanzas (verified empirically; it does work for library stanzas). So the
; mcp-kit-dependent code lives behind a (select ...) instead: cabal_mcp_impl.ml
; resolves to cabal_mcp_impl.real.ml when mcp-kit is available (e.g. pinned,
; or in the Epure monorepo) and to cabal_mcp_impl.stub.ml otherwise, which
; keeps this executable buildable everywhere.

(executable
 (name cabal_mcp)
 (libraries
  cabal
  eio
  eio_main
  eio_posix
  yojson
  (select
   cabal_mcp_impl.ml
   from
   (mcp-kit mcp-kit.stdio -> cabal_mcp_impl.real.ml)
   (-> cabal_mcp_impl.stub.ml)))
 (modules cabal_mcp cabal_mcp_impl))
